# ContextBridge Environment Variables
# Copy this file to .env and fill in your keys

# OpenAI (required for GPT adapter)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (required for Claude adapter)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Default model adapter: openai | claude | local
CB_DEFAULT_ADAPTER=openai

# Storage directory (default: ~/.contextbridge)
CB_STORAGE_DIR=
