# ContextBridge environment variables
# Copy this file to .env and fill in only what you use. Nothing here is required
# for the offline workflow (rule-based extraction, SQLite storage, lexical retrieval).

# --- Vendor keys (only needed for the matching extraction engine / query target) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Engines ---
# Default extraction engine: local (offline rules) | openai | claude | <ollama model name>
CB_DEFAULT_ADAPTER=local

# --- Storage ---
# Directory for packages, attached files, and the watch folder (default: ~/.contextbridge)
CB_STORAGE_DIR=
# sqlite (default) | postgres (pgvector-enabled, for deployments) | json (legacy)
CB_STORAGE_BACKEND=sqlite
# PostgreSQL DSN; setting it selects the postgres backend when CB_STORAGE_BACKEND is unset
CB_DATABASE_URL=

# --- Privacy ---
# Redact secrets/PII before storing or exporting memory (default: true)
CB_REDACT=true

# --- HTTP server (cb serve) ---
CB_HOST=127.0.0.1
CB_PORT=5000
# Shared secret for the JSON API (X-API-Key header). Empty = no auth (loopback only!)
CB_API_KEY=
# development | staging | production (reported in /api/v1/health and trace resources)
CB_ENVIRONMENT=development
# Origins allowed to call the API from a browser (the Chrome extension's sites)
CB_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://claude.ai
CB_MAX_UPLOAD_MB=25
CB_MAX_TEXT_CHARS=2000000
# Set to true only for local development of the legacy Flask dashboard
CB_DEBUG=false
CB_LOG_LEVEL=INFO

# --- Observability (OpenTelemetry) ---
# Traces are exported when an OTLP endpoint is set (or CB_OTEL_ENABLED=true)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=contextbridge
CB_OTEL_ENABLED=
# Print spans to stdout as well (debugging)
CB_OTEL_CONSOLE=false

# --- Tests / benchmarks ---
# pgvector database used by the integration tests and benchmarks (skipped when empty)
CB_TEST_DATABASE_URL=
CB_BENCH_DATABASE_URL=
